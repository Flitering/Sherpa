{
  "name": "sherpa",
  "private": true,
  "version": "0.1.7",
  "description": "Проводник по квестам Escape from Tarkov: карты, маршруты, нужные предметы",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-data.mjs && electron scripts/style-maps.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "node scripts/copy-ocr.mjs && node scripts/desktop-dev.mjs",
    "desktop": "npm run build && electron .",
    "dist": "node scripts/make-license.mjs && npm run build && electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "prebuild": "node scripts/copy-ocr.mjs",
    "predev": "node scripts/copy-ocr.mjs",
    "sync:quests": "node scripts/sync-market-quests.mjs"
  },
  "devDependencies": {
    "@fontsource/roboto-condensed": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@types/leaflet": "1.9.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "leaflet": "1.9.4",
    "playwright-core": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "typescript": "5.6.3",
    "vite": "7.3.7"
  },
  "main": "electron/main.mjs",
  "author": "Sherpa",
  "build": {
    "appId": "app.sherpa.tarkov",
    "productName": "Sherpa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "scripts/sync-data.mjs",
      "scripts/market-quests.json",
      "scripts/quest-overrides.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sherpa",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "Sherpa-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "license": "electron/assets/license.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Flitering",
        "repo": "Sherpa",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
